# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave empty for SQLite (backend/db.sqlite3). Example for PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/portfolio

# --- Admin ---
# Non-default admin path (adds obscurity on top of Django's built-in auth)
ADMIN_URL=staff/

# --- HTTPS (enable in production behind TLS) ---
HTTPS=False
SECURE_HSTS_SECONDS=0

# --- CORS ---
# Origins allowed to call the API cross-origin (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
# Only enable when behind a trusted reverse proxy that sets X-Forwarded-For
RATE_LIMIT_TRUST_PROXY=False
